__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# User/reference media and generated outputs can be large or credential-adjacent.
data/samples/*
data/library
artifacts/
hyperframes/**/assets/*.mp4
hyperframes/**/assets/*.mov
hyperframes/**/assets/*.webm

# Editable video projects keep source, prompts, and production records. Staged,
# captured, generated, and rendered media stays local; final MP4s live under the
# ignored artifacts/ tree and are listed in assembled_outputs/ manifests.
videos/**/*.mp4
videos/**/*.mov
videos/**/*.webm
videos/**/*.wav
videos/**/*.mp3
videos/**/*.m4a
videos/**/*.ttf
videos/**/*.jpg
videos/**/*.jpeg
videos/**/*-source.png
videos/**/*.log
videos/**/budget.lock
videos/**/.thumbnails/
videos/**/.hyperframes/
videos/**/.waveform-cache/
videos/**/snapshots/
videos/**/renders/
videos/**/capture/screenshots/
videos/**/capture/assets/*.png
videos/**/capture/extracted/page.html

# Reference footage stays local (see references/human-realism/.gitignore).
references/**/*.mp4
references/**/*.mov
references/**/*.webm

# Keep workspace coordination files local to Conductor.
.context/

.env
.env.*
*.pem
*.key
secrets/
credentials/

# Generated HyperFrames files
hyperframes/**/.thumbnails/
hyperframes/**/snapshots/
hyperframes/**/renders/
hyperframes/**/.media/

# Local media/assets that don't need to be in Git
hyperframes/**/assets/*.m4a
hyperframes/**/assets/*.ttf

# Synthesized audio is regenerated deterministically by scripts/prepare_*_assets.py
# from a fixed seed, so committing ~55MB of WAV would bloat history for no gain.
hyperframes/**/assets/*.wav
hyperframes/**/assets/vo/*.wav

# Bundled SFX are Pixabay-licensed and are re-staged from the media-use skill by
# the prepare_*_assets.py scripts, so assets/ stays entirely regenerable.
hyperframes/**/assets/*.mp3

# Generated diagnostics and OS cruft
hyperframes/**/.hyperframes/
hyperframes/**/.waveform-cache/
.DS_Store
**/.DS_Store
