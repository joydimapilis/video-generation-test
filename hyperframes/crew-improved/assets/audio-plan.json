  "caption_schedule": [
    {
      "in": 0.0,
      "out": 3.9,
      "text": "We're a bakery. Six people, two ovens,"
    },
    {
      "in": 4.02,
      "out": 6.95,
      "text": "and a lot of very early mornings."
    },
    {
      "in": 9.55,
      "out": 15.55,
      "text": "Every Sunday night I'd sit down with a pencil and rebuild the staff schedule."
    },
    {
      "in": 15.7,
      "out": 21.0,
      "text": "Someone's got an exam. Someone's kid is sick. Start again."
    },
    {
      "in": 23.0,
      "out": 28.125,
      "text": "We use Crew now. Everyone puts their availability on their phone."
    },
    {
      "in": 28.125,
      "out": 32.75,
      "text": "It builds the schedule around that, and everyone sees an update."
    },
    {
      "in": 37.0,
      "out": 39.6,
      "text": "Now the whole schedule takes about nine minutes."
    },
    {
      "in": 41.26,
      "out": 42.8,
      "text": "I got my Sundays back."
    }
